meta {
  name: embed one sentence
  type: http
  seq: 2
}

post {
  url: {{ollama}}/api/embed
  body: json
  auth: none
}

body:json {
  {
    "model": "{{embedModel}}",
    "input": "How many working days of annual leave does an employee with 7 years of service get?"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("one sentence becomes 1024 numbers", function () {
    expect(res.getBody().embeddings[0].length).to.equal(1024);
  });
}

docs {
  This is step 4 by hand. The answer is `embeddings[0]`: 1024 numbers — the sentence's position in
  the model's meaning space. Change one word of `input` and send again: most numbers move a little.
  Nothing in the numbers is readable; only their distance to OTHER vectors means anything.
}
