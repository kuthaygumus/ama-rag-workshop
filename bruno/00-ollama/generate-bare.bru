meta {
  name: bare answer (no RAG)
  type: http
  seq: 3
}

post {
  url: {{ollama}}/api/generate
  body: json
  auth: none
}

body:json {
  {
    "model": "{{chatModel}}",
    "system": "Answer briefly.",
    "prompt": "How many working days of annual leave does an employee with 7 years of service get?",
    "stream": false,
    "options": { "temperature": 0, "seed": 42 }
  }
}

assert {
  res.status: eq 200
}

docs {
  Step 0 by hand: the model alone, no documents. Read `response` — and ask yourself where that number
  came from. `prompt_eval_count` is how many tokens it read; remember it for step 8.
}
