# Copy to a file named .env to change a setting without typing a flag every time (works the same on Mac and Windows).
# OLLAMA_URL=http://localhost:11434
# CHROMA_URL=http://localhost:8000
# CHAT_MODEL=gemma3:4b
# EMBED_MODEL=bge-m3
# STORE=chroma          # chroma | json  (json = no Podman needed)
# EDITION=2025          # which corpus/<edition>/ folder step 1 reads
